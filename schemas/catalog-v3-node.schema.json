{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content-addressed v3 metadata graph node",
  "type": "object",
  "required": [
    "schemaVersion",
    "family",
    "kind"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "family": {
      "enum": [
        "records",
        "postings",
        "terms",
        "facets",
        "sources"
      ]
    },
    "kind": {
      "enum": [
        "branch",
        "leaf"
      ]
    },
    "children": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "$ref": "catalog-v3.schema.json#/$defs/descriptor"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096
    },
    "source": {
      "type": "object",
      "required": [
        "owner",
        "repo",
        "commit"
      ],
      "properties": {
        "owner": {
          "const": "shAdow-XJY-Games"
        },
        "repo": {
          "enum": [
            "Shadow3DAssetLibrary",
            "Shadow3DAssetLibrary02"
          ]
        },
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$",
          "not": {
            "const": "0000000000000000000000000000000000000000"
          }
        }
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "owner",
          "repo",
          "commit"
        ],
        "properties": {
          "owner": {
            "const": "shAdow-XJY-Games"
          },
          "repo": {
            "enum": [
              "Shadow3DAssetLibrary",
              "Shadow3DAssetLibrary02"
            ]
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40}$",
            "not": {
              "const": "0000000000000000000000000000000000000000"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "branch"
          }
        }
      },
      "then": {
        "required": [
          "children"
        ],
        "not": {
          "required": [
            "entries"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "leaf"
          }
        }
      },
      "then": {
        "required": [
          "entries"
        ],
        "not": {
          "required": [
            "children"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "records"
          },
          "kind": {
            "const": "leaf"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "$ref": "asset-v1.schema.json"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "postings"
          },
          "kind": {
            "const": "leaf"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "sources"
          },
          "kind": {
            "const": "leaf"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 1024
                },
                {
                  "$ref": "catalog-v3.schema.json#/$defs/source"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "facets"
          },
          "kind": {
            "const": "leaf"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "pattern": "^(repository|assetKind|category|theme|style)\\u0000",
                  "maxLength": 1024
                },
                {
                  "type": "integer",
                  "minimum": 1
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "family": {
            "const": "terms"
          },
          "kind": {
            "const": "leaf"
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string",
                  "maxLength": 1024
                },
                {
                  "anyOf": [
                    {
                      "$ref": "catalog-v3.schema.json#/$defs/descriptor"
                    },
                    {
                      "$ref": "#/$defs/inlinePosting"
                    }
                  ]
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "inlinePosting": {
      "type": "object",
      "required": [
        "ids",
        "count",
        "min",
        "max"
      ],
      "properties": {
        "ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$comment": "Runtime validates per-family tuple shapes, strict sorted unique keys, contiguous record ordinals, range/count/height, <=128 entries except <=4096 posting IDs, source ownership and the unchanged asset-v1 schema. Every node <=262144 actual decoded UTF-8 bytes. Offline audit regenerates every facet/posting tree and validates globally unique asset IDs."
}
