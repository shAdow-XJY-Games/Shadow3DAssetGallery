-01/v1.0.0/model.glb","size":21392,"sha256":"3242f9c1cd7b72833e5978c9cc6505f88c91d6e78db3705a0f9d3268597eb6af"},"blend":{"path":"assets/village/agriculture-threshing-flail-01/v1.0.0/source.blend","size":630904,"sha256":"5ad9438ce1294a3164ed310a8418c720b65b9067766bac6869fa3f1bc51b090d"},"generator":{"path":"assets/village/agriculture-threshing-flail-01/v1.0.0/generate.py","size":34323,"sha256":"14cbec0012b699bfad98425a6df07137c6fb4e9f583842021b16734134582a1e"},"render":{"path":"assets/village/agriculture-threshing-flail-01/v1.0.0/thumbnail.png","size":172160,"sha256":"b22ac170a745dc8339c8c4732ed7bd77f5fcb107eb6d1a88d00b799643b2899f"}},"status":"verified","license":"All rights reserved","sourceId":"agriculture-flail-extension"}],[99,{"id":"transport-boat-launch-scene-01","version":"1.0.0","category":"scenes","assetKind":"scene","theme":"transport","style":"soft-low-poly","title":"Work Skiff Launch Point","description":"Original shoreline launch display with a work skiff, modular ramp, shore bank and an independent opaque water-surface node. Hull bottom sits 0.12 m below water surface; boat is displayed afloat, not physically simulated or ground-supported. The static water cavity is bound to the current boat placement; change BOAT_POSITION and regenerate the water mesh before repositioning the boat.","bounds":{"x":5,"y":6.3,"z":0.835,"unit":"m"},"triangles":516,"materials":4,"files":{"glb":{"path":"assets/transport/transport-boat-launch-scene-01/v1.0.0/model.glb","size":41376,"sha256":"f6c36a615010dde6fa3f01d7b6a72ec9691f5f3785ac6a794dc6f9a2e09dad97"},"blend":{"path":"assets/transport/transport-boat-launch-scene-01/v1.0.0/source.blend","size":606804,"sha256":"060cd23c16406edf2284a03046523f41e9e3b843a9499fb6bc1c03eec056721d"},"generator":{"path":"assets/transport/transport-boat-launch-scene-01/v1.0.0/generate.py","size":29695,"sha256":"d304acdd96f3ca802b3373f49e155f962eb03b92dcec416b2e3f1b51a476c180"},"render":{"path":"assets/transport/transport-boat-launch-scene-01/v1.